        <title>VG2 MAG Uranus Longitude (U1) Coordinate 1.92s 1986-01-24 ASCII Data</title>
        <information_model_version>1.24.0.0</information_model_version>
        <product_class>Product_Observational</product_class>
        <Citation_Information>
            <publication_year>1993</publication_year>
            <description>
                This file contains ASCII data from the Voyager 2 
                Magnetometer in Uranus Longitude (U1) Coordinates 
                during the Uranus Encounter. The data have been averaged 
                from the 60ms instrument sample rate to a 1.92s resampled rate. 
                These data cover 1986-01-24T07:00:00.005Z to 1986-01-24T23:59:59.937Z.
            </description>
            <List_Author>
                <Person>
                    <given_name>Norman</given_name>
                    <family_name>Ness</family_name>
                    <sequence_number>1</sequence_number>
                    <Affiliation>
