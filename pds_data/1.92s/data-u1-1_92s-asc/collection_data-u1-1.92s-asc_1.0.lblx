        <logical_identifier>urn:nasa:pds:vg2-mag-uranus:data-u1-1.92s-asc</logical_identifier>
        <version_id>1.0</version_id>
        <title>VG2 MAG Uranus Longitude (U1) Coordinate 1.92s ASCII Data Collection</title>
        <information_model_version>1.24.0.0</information_model_version>
        <product_class>Product_Collection</product_class>
        <Citation_Information>
            <publication_year>1993</publication_year>
            <doi>10.17189/kqdm-kc56</doi>
            <description>
                This collection contains ASCII data from the Voyager 2
                Magnetometer in Uranus Longitude (U1) Coordinates during
                the Uranus Encounter. The data have been averaged from the
                60ms instrument sample rate to a 1.92s resampled rate. These
                data cover 1986-01-24T07:00:00.005Z to 1986-01-25T03:59:58.001Z.
            </description>
            <List_Author>
                <Person>
                    <given_name>Norman</given_name>
                    <family_name>Ness</family_name>
                    <sequence_number>1</sequence_number>
                    <Affiliation>
                        <organization_name>NASA Goddard Space Flight Center</organization_name>
                        <organization_rorid>https://ror.org/0171mag52</organization_rorid>
                    </Affiliation>
                </Person>
            </List_Author>
        </Citation_Information>
        <Modification_History>
            <Modification_Detail>
                <modification_date>2026-02-26</modification_date>
                <version_id>1.0</version_id>
                <description>
                    This is the original version of this collection in PDS4.
                </description>
            </Modification_Detail>
        </Modification_History>
    </Identification_Area>
